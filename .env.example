# Copy to .env and fill in at least one provider. Leave all empty for local mock replies.
#
# Google AI Studio (Gemini) — if set, used first
GOOGLE_AI_API_KEY=
# Alias:
# GEMINI_API_KEY=
# Model id (default gemini-2.5-flash). gemini-1.5-flash often returns 404 on current API.
# 429 quota: try gemini-2.5-flash-lite, or wait / enable billing.
# List names: GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
GEMINI_MODEL=gemini-2.5-flash
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
